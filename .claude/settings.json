{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "japanese",
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python *)",
      "Bash(.venv/bin/pip *)",
      "Bash(python track.py *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(git reset --hard*)",
      "Bash(sudo *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.cache/huggingface/token)",
      "Read(~/.cache/huggingface/stored_tokens)",
      "Bash(cat ~/.cache/huggingface/*)",
      "Bash(hf auth token*)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)"
    ]
  }
}
